PORT=3000
NODE_ENV=development

# Redis Configuration for BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Upload Configuration
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads/submissions

# CORS Configuration
CORS_ORIGIN=http://localhost:5174,http://localhost:3000,*

# Google OAuth 2.0 — the client ID whose tokens this API accepts.
# MUST match VITE_GOOGLE_CLIENT_ID in frontend/.env, otherwise ID tokens are rejected
# with an `aud` (audience) mismatch. Leave empty to disable Google token verification,
# in which case the API refuses email-only Google sign-in entirely.
GOOGLE_CLIENT_ID=

# JWT Secret
JWT_SECRET=aita_super_secret_jwt_key_swp391_2026

# Gmail SMTP Configuration for sending OTP
# Để gửi email thật qua Gmail, bạn cần bật Xác minh 2 bước và tạo "Mật khẩu ứng dụng" (App Password)
SMTP_USER=
SMTP_PASS=
