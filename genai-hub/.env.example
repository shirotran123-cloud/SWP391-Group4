# AITA GenAI Core & Review Hub Configuration

# Default Provider: 'mock' (for local testing/CI without keys), 'gemini', or 'openai'
DEFAULT_LLM_PROVIDER=mock

# Google Gemini API Keys (comma-separated for round-robin rotation pool)
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Keys (comma-separated for round-robin rotation pool)
OPENAI_API_KEYS=sk-proj-your_key_1,sk-proj-your_key_2
OPENAI_MODEL=gpt-4o

# Deterministic Evaluation Settings
AI_TEMPERATURE=0.2
MAX_TOKEN_WINDOW=8192

# Reliability & Rate-Limit Backoff (DEP-02, R01)
MAX_RETRIES=2
RETRY_BACKOFF_MS=1000
TIMEOUT_MS=30000
