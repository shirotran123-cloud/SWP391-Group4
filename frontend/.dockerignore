# Keep the build context small and, more importantly, reproducible across platforms.
#
# `node_modules` and `package-lock.json` are deliberately excluded. A lockfile generated on the
# developer's machine records platform-specific native binaries (for example
# `@rolldown/binding-win32-x64-msvc`), and npm refuses to install those on Linux:
#
#   npm error code EBADPLATFORM
#   notsup Unsupported platform for @rolldown/binding-win32-x64-msvc
#
# Copying the host's tree into a Linux image therefore breaks the build outright. Excluding it
# lets npm resolve the correct native packages for the target platform inside the image.

node_modules
**/node_modules

package-lock.json
npm-debug.log*
yarn-error.log*

# Build output is produced inside the image; never inherit the host's.
dist
build
coverage
.nyc_output

# Local secrets must never be baked into an image layer.
.env
.env.*
!.env.example

# Tests and tooling are not needed to build or run the deployed service.
src/**/*.test.ts
src/**/*.spec.ts
test
scripts

.git
.gitignore
.github
*.md
Dockerfile
.dockerignore
